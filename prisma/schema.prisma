generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth v5)
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  logEntries         LogEntry[]
  areaScoreOverrides AreaScoreOverride[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

enum ZoneType {
  HOUSE
  GARDEN
  GARAGE
  CARS
}

enum EffortLevel {
  QUICK
  MEDIUM
  INVOLVED
}

enum BacklogStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model Zone {
  id        String   @id @default(cuid())
  name      String
  type      ZoneType @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas        Area[]
  backlogItems BacklogItem[]
}

model Area {
  id         String    @id @default(cuid())
  zoneId     String
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  zone           Zone                @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  areaTasks      AreaTask[]
  scoreOverrides AreaScoreOverride[]
  backlogItems   BacklogItem[]

  @@index([zoneId])
}

model TaskType {
  id                  String      @id @default(cuid())
  name                String
  defaultFrequencyDays Int
  // Length-12 per-month multiplier on frequency; 1 = neutral.
  seasonalMultipliers Float[]
  effortLevel         EffortLevel
  defaultWeight       Float       @default(1)
  applicableZoneTypes ZoneType[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  areaTasks AreaTask[]
}

model AreaTask {
  id                   String   @id @default(cuid())
  areaId               String
  taskTypeId           String
  frequencyDaysOverride Int?
  weightOverride       Float?
  onHold               Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  area     Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  taskType TaskType @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  logEntries LogEntry[]

  @@unique([areaId, taskTypeId])
  @@index([areaId])
}

model LogEntry {
  id            String   @id @default(cuid())
  areaTaskId    String
  completedAt   DateTime
  note          String?
  qualityRating Int?
  photoUrl      String?
  loggedById    String
  createdAt     DateTime @default(now())

  areaTask AreaTask @relation(fields: [areaTaskId], references: [id], onDelete: Cascade)
  loggedBy User     @relation(fields: [loggedById], references: [id])

  @@index([areaTaskId])
}

model AreaScoreOverride {
  id      String   @id @default(cuid())
  areaId  String
  score   Int
  note    String?
  setAt   DateTime
  setById String
  createdAt DateTime @default(now())

  area  Area @relation(fields: [areaId], references: [id], onDelete: Cascade)
  setBy User @relation(fields: [setById], references: [id])

  @@index([areaId])
}

model BacklogItem {
  id          String        @id @default(cuid())
  zoneId      String
  areaId      String?
  title       String
  description String?
  status      BacklogStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  zone Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  area Area? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([zoneId])
  @@index([areaId])
}
