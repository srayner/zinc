{
  "name": "zinc",
  "version": "0.1.10",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null && git config branch.main.mergeoptions '--no-ff --no-commit' 2>/dev/null || true",
    "predev": "prisma generate",
    "dev": "next dev -p 3007",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start -p ${PORT:-3007}",
    "lint": "next lint",
    "seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "pretest:unit": "prisma generate",
    "test:unit": "vitest run",
    "pretest:unit:watch": "prisma generate",
    "test:unit:watch": "vitest",
    "pretest:unit:coverage": "prisma generate",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.1",
    "@hookform/resolvers": "^5.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^18.0.10",
    "lucide-react": "^0.503.0",
    "next": "^15.5.9",
    "next-auth": "^5.0.0-beta",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "^15.5.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.2.8",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "vitest-mock-extended": "^2.0.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    },
    "@prisma/config": {
      "effect": "^3.22.5"
    }
  }
}
