#!/bin/bash
# Auto-bump the patch version on every commit made on `main`, so each update
# to main carries a new version number. Feature branches are left untouched.
set -e

BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" != "main" ]; then
  exit 0
fi

# Don't bump if package.json's version line is already part of this commit
# (e.g. a manual `npm version` bump) — avoids double-incrementing.
if git diff --cached -U0 -- package.json | grep -qE '^\+\s*"version":'; then
  exit 0
fi

CURRENT=$(node -p "require('./package.json').version")
npm version patch --no-git-tag-version --allow-same-version >/dev/null
NEXT=$(node -p "require('./package.json').version")

git add package.json package-lock.json
echo "pre-commit: version bumped ${CURRENT} -> ${NEXT}"
