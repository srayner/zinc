# Copy to .env and fill in. .env* is gitignored.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/zinc?schema=public"

# NextAuth v5 — generate a secret with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3007"

# Passwords for the two demo accounts created by `npm run seed`
USER_PASSWORD_USER="password"
USER_PASSWORD_ADMIN="admin"
